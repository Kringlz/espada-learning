EXPO_PUBLIC_DATA_MODE=demo
# Public client credentials only. RLS protects data. Never place service-role or AI secrets here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ENV=development

# Optional LOCAL web preview only; never configure on GitHub Pages.
# Requires the explicit local PostgreSQL preview server (docs/LESSONS.md).
# EXPO_PUBLIC_LESSON_PREVIEW_URL=http://127.0.0.1:55433
