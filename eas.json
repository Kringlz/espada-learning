      "env": { "APP_ENV": "development", "EXPO_PUBLIC_DATA_MODE": "demo" }
    },
    "connected": {
      "env": {
        "EXPO_PUBLIC_DATA_MODE": "supabase",
        "EXPO_PUBLIC_SUPABASE_URL": "https://anugktopawgukdxhqvze.supabase.co",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_JePCMPnuVbjTg6ZmGmVfLg_6Hq7SjO1"
      }
